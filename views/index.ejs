<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Shadow City Generator Frontend</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <!-- Leaflet JavaScript -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <!-- Proj4js for coordinate projections -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/proj4js/2.9.0/proj4.js"></script>

</head>

<body>
  <div class="container">
    <h1 class="mt-5">Shadow City Generator</h1>
    <p class="lead">Select an area on the map and choose features to include. Live previews and downloadable outputs will
      appear on the right.</p>

    <!-- Hidden field to store generated geojson file path -->
    <input type="hidden" id="generatedFile" name="generatedFile" value="">

    <div class="row">
      <!-- Left Column: Form and Options -->
      <div class="col-md-4">
        <form id="optionsForm">
          <!-- Selected Area -->
          <fieldset class="border p-3 mb-3">
            <legend class="w-auto">Selected Area</legend>
            <div class="form-group">
              <label for="crop-bbox">Bounding Box</label>
              <input type="text" class="form-control" id="crop-bbox" name="crop-bbox"
                placeholder="Select an area on the map" readonly>
              <small class="form-text text-muted">Format: south, west, north, east</small>
            </div>
          </fieldset>

          <!-- Feature Selection -->
          <fieldset class="border p-3 mb-3">
            <legend class="w-auto">OSM Features to Include</legend>
            <div class="form-group form-check">
              <input type="checkbox" class="form-check-input feature-select" id="include-buildings" name="include-buildings" checked>
              <label class="form-check-label" for="include-buildings">Buildings</label>
            </div>
            <div class="form-group form-check">
              <input type="checkbox" class="form-check-input feature-select" id="include-roads" name="include-roads" checked>
              <label class="form-check-label" for="include-roads">Roads</label>
            </div>
            <div class="form-group form-check">
              <input type="checkbox" class="form-check-input feature-select" id="include-water" name="include-water" checked>
              <label class="form-check-label" for="include-water">Water Features</label>
            </div>
            <div class="form-group form-check">
              <input type="checkbox" class="form-check-input feature-select" id="include-railways" name="include-railways" checked>
              <label class="form-check-label" for="include-railways">Railways</label>
            </div>
            <div class="form-group form-check">
              <input type="checkbox" class="form-check-input feature-select" id="include-parks" name="include-parks">
              <label class="form-check-label" for="include-parks">Parks & Leisure</label>
            </div>
            <button type="button" id="fetchDataBtn" class="btn btn-primary btn-block" disabled>
              <span id="fetchBtnText">Select an area on the map first</span>
              <span id="fetchSpinner" class="spinner-border spinner-border-sm ml-2" style="display: none;"></span>
            </button>
          </fieldset>

          <!-- Basic Options -->
          <fieldset class="border p-3 mb-3">
            <legend class="w-auto">Basic Options</legend>
            <div class="form-group">
              <label for="size">Model Size (mm)</label>
              <input type="number" class="form-control live-preview" id="size" name="size" value="200" required>
            </div>
            <div class="form-group">
              <label for="height">Maximum Height (mm)</label>
              <input type="number" class="form-control live-preview" id="height" name="height" value="20" required>
            </div>
            <div class="form-group">
              <label>
                Roof Styles
                <span class="tooltip-icon" data-toggle="tooltip" data-placement="right" 
                      title="Select one or more roof styles. Buildings will randomly use one of the selected styles.">ⓘ</span>
              </label>
              <div class="roof-style-container border rounded p-3">
                <div class="form-check">
                  <input class="form-check-input roof-style-checkbox live-preview" type="checkbox" value="flat" id="roof-flat">
                  <label class="form-check-label" for="roof-flat">
                    Flat
                    <small class="text-muted">- Modern flat roofs with clean lines</small>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input roof-style-checkbox live-preview" type="checkbox" value="pitched" id="roof-pitched">
                  <label class="form-check-label" for="roof-pitched">
                    Pitched
                    <small class="text-muted">- Traditional peaked roofs with two sloping sides</small>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input roof-style-checkbox live-preview" type="checkbox" value="tiered" id="roof-tiered">
                  <label class="form-check-label" for="roof-tiered">
                    Tiered
                    <small class="text-muted">- Multi-level roofs that step down</small>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input roof-style-checkbox live-preview" type="checkbox" value="sawtooth" id="roof-sawtooth">
                  <label class="form-check-label" for="roof-sawtooth">
                    Sawtooth
                    <small class="text-muted">- Industrial-style roofs with angled slopes</small>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input roof-style-checkbox live-preview" type="checkbox" value="modern" id="roof-modern">
                  <label class="form-check-label" for="roof-modern">
                    Modern
                    <small class="text-muted">- Contemporary roofs with setbacks</small>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input roof-style-checkbox live-preview" type="checkbox" value="stepped" id="roof-stepped">
                  <label class="form-check-label" for="roof-stepped">
                    Stepped
                    <small class="text-muted">- Roofs with distinct stepped levels</small>
                  </label>
                </div>
                <div class="mt-2">
                  <button type="button" class="btn btn-sm btn-secondary" id="select-all-roofs">Select All</button>
                  <button type="button" class="btn btn-sm btn-secondary" id="clear-all-roofs">Clear All</button>
                </div>
              </div>
              <small class="form-text text-muted">
                <span id="roof-style-description">Select at least one roof style</span>
              </small>
            </div>
            <div class="form-group">
              <label for="detail">Detail Level (0-2)</label>
              <input type="number" step="0.1" class="form-control live-preview" id="detail" name="detail" value="1.0"
                required>
            </div>
            <div class="form-group">
              <label for="merge-distance">Merge Distance</label>
              <input type="number" step="0.1" class="form-control live-preview" id="merge-distance"
                name="merge-distance" value="2.0">
            </div>
            <div class="form-group">
              <label for="cluster-size">Cluster Size</label>
              <input type="number" step="0.1" class="form-control live-preview" id="cluster-size" name="cluster-size"
                value="3.0">
            </div>
            <div class="form-group">
              <label for="height-variance">Height Variance</label>
              <input type="number" step="0.1" class="form-control live-preview" id="height-variance"
                name="height-variance" value="0.2">
            </div>
            <div class="form-group">
              <label for="road-width">Road Width (mm)</label>
              <input type="number" step="0.1" class="form-control live-preview" id="road-width" name="road-width"
                value="1.2">
            </div>
            <div class="form-group">
              <label for="water-depth">Water Depth (mm)</label>
              <input type="number" step="0.1" class="form-control live-preview" id="water-depth" name="water-depth"
                value="2">
            </div>
            <div class="form-group">
              <label for="min-building-area">Minimum Building Area (m²)</label>
              <input type="number" step="0.1" class="form-control live-preview" id="min-building-area"
                name="min-building-area" value="200.0">
            </div>
            <div class="form-group form-check">
              <input type="checkbox" class="form-check-input live-preview" id="debug" name="debug">
              <label class="form-check-label" for="debug">Enable Debug Output</label>
            </div>
          </fieldset>

          <!-- Bridge Options -->
          <fieldset class="border p-3 mb-3">
            <legend class="w-auto">Bridge Options</legend>
            <div class="form-group">
              <label for="bridge-height">Bridge Deck Height Above Base</label>
              <input type="number" step="0.1" class="form-control live-preview" id="bridge-height" name="bridge-height"
                value="2.0">
            </div>
            <div class="form-group">
              <label for="bridge-thickness">Bridge Deck Thickness</label>
              <input type="number" step="0.1" class="form-control live-preview" id="bridge-thickness"
                name="bridge-thickness" value="0.6">
            </div>
            <div class="form-group">
              <label for="support-width">Bridge Support Radius</label>
              <input type="number" step="0.1" class="form-control live-preview" id="support-width" name="support-width"
                value="2.0">
            </div>
          </fieldset>


          <!-- Final Render Button -->
          <button type="button" id="renderBtn" class="btn btn-success mb-3">Render Final Model</button>
        </form>
      </div>

      <!-- Right Column: Live Previews and Downloadable Files -->
      <div class="col-md-8">
        <!-- Map Selection Container -->
        <div class="map-container mb-3">
          <h3>Select Area</h3>
          <div id="map" style="height: 400px; border: 2px solid #ddd; border-radius: 4px;"></div>
          <div id="selection-status" class="mt-2 alert alert-info" style="display: none;"></div>
          <div class="mt-2">
            <button class="btn btn-sm btn-warning" id="restart-selection" style="display: none;">
              <i class="bi bi-arrow-clockwise"></i> Restart Selection
            </button>
            <button class="btn btn-sm btn-secondary" id="clear-selection" style="display: none;">
              <i class="bi bi-x-circle"></i> Clear Selection
            </button>
            <button class="btn btn-sm btn-info float-right" id="copy-bbox">
              <i class="bi bi-clipboard"></i> Copy Coordinates
            </button>
          </div>
        </div>

        <div class="processing-indicator">
          Processing changes... Preview will update in 2 seconds.
        </div>

        <div class="preview-container">
          <h3>Live Preview - Main Model</h3>
          <img id="previewMain" src="" alt="Main Model Preview" style="display: none;">
        </div>

        <!--      <div class="preview-container">
          <h3>Live Preview - Frame Model</h3>
          <img id="previewFrame" src="" alt="Frame Model Preview" style="display: none;">
        </div>
      -->
        <!-- Add to views/index.ejs, inside the log-container div -->
        <div class="log-container">
          <h4>Live Log <button id="clearLogBtn" class="btn btn-sm btn-secondary float-right">Clear Log</button></h4>
          <div id="liveLog"></div>
        </div>

        <div class="download-links mt-4">
          <h4>Download Rendered Files</h4>
          <div id="downloadLinks">
            <!-- Links will be inserted here after final render -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Initialize tooltips
    $(document).ready(function() {
      $('[data-toggle="tooltip"]').tooltip();
      
      // Select all roof styles by default
      $('.roof-style-checkbox').prop('checked', true);
      updateRoofStyleDescription();
      
      // Initialize the map
      initializeMap();
    });

    // Handle select all button
    $('#select-all-roofs').on('click', function() {
      $('.roof-style-checkbox').prop('checked', true);
      updateRoofStyleDescription();
      debouncedUpdatePreview();
    });

    // Handle clear all button
    $('#clear-all-roofs').on('click', function() {
      $('.roof-style-checkbox').prop('checked', false);
      updateRoofStyleDescription();
    });

    // Update description when checkboxes change
    $('.roof-style-checkbox').on('change', function() {
      updateRoofStyleDescription();
    });

    function updateRoofStyleDescription() {
      const selectedStyles = $('.roof-style-checkbox:checked').map(function() {
        return $(this).val();
      }).get();

      if (selectedStyles.length === 0) {
        $('#roof-style-description').text('Please select at least one roof style');
        $('#roof-style-description').addClass('text-danger');
      } else if (selectedStyles.length === 1) {
        $('#roof-style-description').text(`All buildings will use ${selectedStyles[0]} roof style`);
        $('#roof-style-description').removeClass('text-danger');
      } else if (selectedStyles.length === 6) {
        $('#roof-style-description').text('All roof styles selected - buildings will use random styles');
        $('#roof-style-description').removeClass('text-danger');
      } else {
        $('#roof-style-description').text(`Buildings will randomly use: ${selectedStyles.join(', ')}`);
        $('#roof-style-description').removeClass('text-danger');
      }
    }

    // Helper function to get selected roof styles
    function getSelectedRoofStyles() {
      const styles = $('.roof-style-checkbox:checked').map(function() {
        return $(this).val();
      }).get();
      return styles.length > 0 ? styles.join(',') : 'flat'; // Default to flat if none selected
    }

    // ========== MAP FUNCTIONALITY ==========
    let map, selecting = false, anchorLatLng = null, anchorMarker = null, rect = null, selectedBbox = null;
    
    // Define projections
    proj4.defs("EPSG:4326", "+proj=longlat +datum=WGS84 +no_defs");
    proj4.defs("EPSG:3857", "+proj=merc +lon_0=0 +k=1 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs");
    
    function initializeMap() {
      // Initialize Leaflet map
      map = L.map('map').setView([40.7128, -74.0060], 12); // Default to NYC
      
      // Add OpenStreetMap tiles
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);
      
      // Handle map clicks for bbox selection
      map.on('click', handleMapClick);
    }
    
    function handleMapClick(e) {
      if (!selecting) {
        // First click: set anchor
        anchorLatLng = e.latlng;
        selecting = true;
        
        // Clear existing selection
        if (rect) {
          map.removeLayer(rect);
          rect = null;
        }
        if (anchorMarker) {
          map.removeLayer(anchorMarker);
        }
        
        // Add anchor marker
        anchorMarker = L.marker(e.latlng, {
          icon: L.divIcon({
            className: 'anchor-marker',
            html: '📍',
            iconSize: [20, 20],
            iconAnchor: [10, 10]
          })
        }).addTo(map);
        
        updateSelectionStatus('Click again to complete the square selection');
        $('#restart-selection, #clear-selection').show();
        
        // Start listening to mouse moves
        map.on('mousemove', onMouseMove);
      } else {
        // Second click: finalize
        selecting = false;
        updateSelectionStatus('Selection completed');
        map.off('mousemove', onMouseMove);
      }
    }
    
    function onMouseMove(e) {
      if (selecting && anchorLatLng) {
        let squareBounds = getSquareBounds(anchorLatLng, e.latlng);
        
        if (rect) {
          rect.setBounds(squareBounds);
        } else {
          rect = L.rectangle(squareBounds, {
            color: 'blue',
            weight: 2,
            fillOpacity: 0.2
          }).addTo(map);
        }
        
        updateBboxInput(squareBounds);
      }
    }
    
    // Enable mousemove listener when selecting
    function startSelecting() {
      map.on('mousemove', onMouseMove);
    }
    
    function getSquareBounds(anchor, mouse) {
      // Convert to Web Mercator for accurate distance calculations
      let anchorMerc = proj4("EPSG:4326", "EPSG:3857", [anchor.lng, anchor.lat]);
      let mouseMerc = proj4("EPSG:4326", "EPSG:3857", [mouse.lng, mouse.lat]);
      
      // Calculate distances
      let dx = mouseMerc[0] - anchorMerc[0];
      let dy = mouseMerc[1] - anchorMerc[1];
      
      // Use max dimension to create square
      let side = Math.max(Math.abs(dx), Math.abs(dy));
      
      // Limit to 10 miles (16093.44 meters)
      const maxSide = 16093.44;
      if (side > maxSide) {
        side = maxSide;
        updateSelectionStatus('Maximum size reached (10×10 miles)');
      } else {
        const sideKm = (side / 1000).toFixed(1);
        const sideMiles = (side / 1609.34).toFixed(1);
        updateSelectionStatus(`Area: ${sideKm}km × ${sideKm}km (${sideMiles}mi × ${sideMiles}mi)`);
      }
      
      // Calculate square corners
      let xSign = dx >= 0 ? 1 : -1;
      let ySign = dy >= 0 ? 1 : -1;
      
      let otherMerc = [
        anchorMerc[0] + side * xSign,
        anchorMerc[1] + side * ySign
      ];
      
      // Get bounds
      let minX = Math.min(anchorMerc[0], otherMerc[0]);
      let maxX = Math.max(anchorMerc[0], otherMerc[0]);
      let minY = Math.min(anchorMerc[1], otherMerc[1]);
      let maxY = Math.max(anchorMerc[1], otherMerc[1]);
      
      // Convert back to lat/lng
      let sw = proj4("EPSG:3857", "EPSG:4326", [minX, minY]);
      let ne = proj4("EPSG:3857", "EPSG:4326", [maxX, maxY]);
      
      return L.latLngBounds(L.latLng(sw[1], sw[0]), L.latLng(ne[1], ne[0]));
    }
    
    function updateBboxInput(bounds) {
      if (bounds) {
        let sw = bounds.getSouthWest();
        let ne = bounds.getNorthEast();
        // Format: south, west, north, east (matching Overpass format)
        let bboxString = `${sw.lat.toFixed(6)}, ${sw.lng.toFixed(6)}, ${ne.lat.toFixed(6)}, ${ne.lng.toFixed(6)}`;
        $('#crop-bbox').val(bboxString);
        selectedBbox = bounds;
        
        // Enable fetch button
        $('#fetchDataBtn').prop('disabled', false);
        $('#fetchBtnText').text('Fetch OSM Data');
        
        // Trigger preview update if data is already fetched
        if ($('#generatedFile').val()) {
          debouncedUpdatePreview();
        }
      }
    }
    
    function updateSelectionStatus(message) {
      if (message) {
        $('#selection-status').text(message).show();
      } else {
        $('#selection-status').hide();
      }
    }
    
    // Button handlers
    $('#restart-selection').on('click', function() {
      selecting = false;
      if (rect) map.removeLayer(rect);
      if (anchorMarker) map.removeLayer(anchorMarker);
      rect = null;
      anchorMarker = null;
      $('#crop-bbox').val('');
      updateSelectionStatus('');
      $(this).hide();
      $('#clear-selection').hide();
    });
    
    $('#clear-selection').on('click', function() {
      selecting = false;
      if (rect) map.removeLayer(rect);
      if (anchorMarker) map.removeLayer(anchorMarker);
      rect = null;
      anchorMarker = null;
      $('#crop-bbox').val('');
      updateSelectionStatus('');
      $(this).hide();
      $('#restart-selection').hide();
    });
    
    $('#copy-bbox').on('click', function() {
      const bboxValue = $('#crop-bbox').val();
      if (bboxValue) {
        navigator.clipboard.writeText(bboxValue).then(function() {
          updateSelectionStatus('Coordinates copied to clipboard!');
          setTimeout(() => updateSelectionStatus(''), 2000);
        });
      }
    });
    
    // Handle manual bbox input changes
    $('#crop-bbox').on('change', function() {
      const value = $(this).val().trim();
      if (value) {
        // Try to parse and display the bbox on the map
        const coords = value.split(',').map(v => parseFloat(v.trim()));
        if (coords.length === 4 && coords.every(c => !isNaN(c))) {
          const [south, west, north, east] = coords;
          const bounds = L.latLngBounds(L.latLng(south, west), L.latLng(north, east));
          
          if (rect) map.removeLayer(rect);
          rect = L.rectangle(bounds, {
            color: 'blue',
            weight: 2,
            fillOpacity: 0.2
          }).addTo(map);
          
          map.fitBounds(bounds);
          selectedBbox = bounds;
        }
      }
    });

    // Initialize Socket.io connection
    const socket = io();
    let currentJobId = null;

    socket.on('connect', () => {
      console.log('Connected to server');
    });

    socket.on('job-output', (data) => {
      if (data.jobId === currentJobId) {
        updateLog(data.data, data.type === 'stderr' ? 'error' : 'info');
      }
    });

    socket.on('job-progress', (data) => {
      if (data.jobId === currentJobId) {
        updateLog(`Progress: ${data.progress}%`);
        // Update progress bar if we add one later
      }
    });

    socket.on('job-completed', (data) => {
      if (data.jobId === currentJobId) {
        updateLog('Job completed successfully!', 'success');
      }
    });

    socket.on('job-failed', (data) => {
      if (data.jobId === currentJobId) {
        updateLog(`Job failed: ${data.error}`, 'error');
      }
    });

    // Clear log button
    $("#clearLogBtn").on("click", function () {
      $("#liveLog").empty();
    });
    // Debounce function to limit how often a function can be called
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        // Show processing indicator
        $(".processing-indicator").show();

        const later = () => {
          clearTimeout(timeout);
          $(".processing-indicator").hide();
          func(...args);
        };

        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    // Function to update the live preview images
    function updatePreview() {
      var generatedFile = $("#generatedFile").val();
      if (!generatedFile) {
        console.log("No data fetched yet.");
        return;
      }

      updateLog("Generating preview...");

      var formData = $("#optionsForm").serializeArray();
      formData.push({ name: "uploadedFile", value: generatedFile });
      
      // Add selected roof styles
      formData.push({ name: "roof-style", value: getSelectedRoofStyles() });

      $.ajax({
        url: "/preview",
        type: "POST",
        data: formData,
        success: function (data) {
          // Subscribe to job updates
          if (currentJobId) {
            socket.emit('unsubscribe-job', currentJobId);
          }
          currentJobId = data.jobId;
          socket.emit('subscribe-job', currentJobId);

          if (data.previewMain && data.previewFrame) {
            $("#previewMain").attr("src", data.previewMain + "?t=" + new Date().getTime()).show();
            $("#previewFrame").attr("src", data.previewFrame + "?t=" + new Date().getTime()).show();
          }

          // Initial log output handled by socket events
        },
        error: function (err) {
          console.error("Error:", err);
          let errorMessage = "An error occurred: ";
          if (err.responseJSON && err.responseJSON.error) {
            errorMessage += err.responseJSON.error;
          } else {
            errorMessage += err.statusText || "Unknown error";
          }
          updateLog(errorMessage, "error");
        }
      });
    }

    // Function to auto-scroll log to the newest entry
    function scrollToBottom() {
      var logContainer = $("#liveLog");
      logContainer.scrollTop(logContainer[0].scrollHeight);
    }

    // Update the updateLog function
    function updateLog(message, level = 'info') {
      const logContainer = $("#liveLog");
      const timestamp = new Date().toLocaleTimeString();
      const logEntry = $("<div>").addClass(`log-entry log-${level}`)
        .text(`[${timestamp}] ${message}`);
      logContainer.append(logEntry);
      scrollToBottom();
    }

    // Create debounced version of updatePreview with 2 second delay
    const debouncedUpdatePreview = debounce(updatePreview, 2000);

    // Handle fetch data button
    $("#fetchDataBtn").on("click", function () {
      if (!selectedBbox) {
        updateLog("Please select an area on the map first", "error");
        return;
      }
      
      const btn = $(this);
      const btnText = $("#fetchBtnText");
      const spinner = $("#fetchSpinner");
      
      // Disable button and show spinner
      btn.prop('disabled', true);
      btnText.text('Fetching OSM data...');
      spinner.show();
      
      // Get selected features
      const features = {
        buildings: $("#include-buildings").is(":checked"),
        roads: $("#include-roads").is(":checked"),
        water: $("#include-water").is(":checked"),
        railways: $("#include-railways").is(":checked"),
        parks: $("#include-parks").is(":checked")
      };
      
      // Get bbox coordinates
      const sw = selectedBbox.getSouthWest();
      const ne = selectedBbox.getNorthEast();
      const bbox = {
        south: sw.lat,
        west: sw.lng,
        north: ne.lat,
        east: ne.lng
      };
      
      updateLog("Fetching OSM data from Overpass API...");
      
      $.ajax({
        url: "/fetchOSMData",
        type: "POST",
        data: JSON.stringify({ bbox, features }),
        contentType: "application/json",
        success: function (data) {
          if (data.filePath) {
            $("#generatedFile").val(data.filePath);
            updateLog("OSM data fetched successfully!", "success");
            debouncedUpdatePreview();
          }
          
          // Re-enable button
          btn.prop('disabled', false);
          btnText.text('Fetch OSM Data');
          spinner.hide();
        },
        error: function (err) {
          console.error("OSM fetch error:", err);
          let errorMessage = "Error fetching OSM data: ";
          if (err.responseJSON && err.responseJSON.error) {
            errorMessage += err.responseJSON.error;
          } else {
            errorMessage += err.statusText || "Unknown error";
          }
          updateLog(errorMessage, "error");
          
          // Re-enable button
          btn.prop('disabled', false);
          btnText.text('Fetch OSM Data');
          spinner.hide();
        }
      });
    });

    // Update live preview when any option changes
    $(".live-preview").on("change keyup", function () {
      debouncedUpdatePreview();
    });

    // Scroll to bottom
    function scrollToBottom() {
      const logContainer = $("#liveLog");
      logContainer.scrollTop(logContainer[0].scrollHeight);
    }

    // Handle final render button click
    $("#renderBtn").on("click", function () {
      var generatedFile = $("#generatedFile").val();
      if (!generatedFile) {
        alert("Please fetch OSM data first by selecting an area and clicking 'Fetch OSM Data'.");
        return;
      }

      updateLog("Generating final render...");
      var formData = $("#optionsForm").serializeArray();
      formData.push({ name: "uploadedFile", value: generatedFile });
      
      // Add selected roof styles
      formData.push({ name: "roof-style", value: getSelectedRoofStyles() });

      $.ajax({
        url: "/render",
        type: "POST",
        data: formData,
        success: function (data) {
          // Subscribe to job updates
          if (currentJobId) {
            socket.emit('unsubscribe-job', currentJobId);
          }
          currentJobId = data.jobId;
          socket.emit('subscribe-job', currentJobId);

          var linksHtml = "";

          if (data.mainScad) {
            linksHtml += '<a href="' + data.mainScad + '" download>Main Model (SCAD)</a><br>';
          }
          if (data.frameScad) {
            linksHtml += '<a href="' + data.frameScad + '" download>Frame Model (SCAD)</a><br>';
          }

          if (data.stlFiles && data.stlFiles.mainStl) {
            linksHtml += '<a href="' + data.stlFiles.mainStl + '" download>Main Model (STL)</a><br>';
          }
          if (data.stlFiles && data.stlFiles.frameStl) {
            linksHtml += '<a href="' + data.stlFiles.frameStl + '" download>Frame Model (STL)</a><br>';
          }

          if (data.logFile) {
            linksHtml += '<a href="' + data.logFile + '" download>Debug Log</a><br>';
          }

          $("#downloadLinks").html(linksHtml);

          // Initial log output handled by socket events
        },
        error: function (err) {
          console.error("Final render error:", err);
          updateLog("Error during final render:\n" + JSON.stringify(err));
          alert("An error occurred during final render.");
        }
      });
    });

  </script>
</body>

</html>